mas multiagentSystem {

    /*
     * Single orchestrator agent.
     * No 'focus:' directive — avoids the Jason 3.3.0 VirtualThread NPE that
     * occurs when JaCaMo auto-generates +!jcm::focus_env_art goals for agents
     * that lack the common-cartago.asl plans.
     *
     * The orchestrator joins workspace w and calls run_all_parallel() on the
     * pyexec artifact directly from its +!start plan.
     */
    agent orchestrator_agent {}

    workspace w {
        artifact pyexec: env.PythonExecArtifact()
    }

    asl-path: ., src/agt
    java-path: ., src/env, src/agt
}
